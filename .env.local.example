NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ALLOWED_EMAILS=

# Shared demo account, used by the Try the demo button and reseeded daily.
# Server only. Never prefix these NEXT_PUBLIC_.
DEMO_EMAIL=
DEMO_PASSWORD=

# The deployed origin. QStash calls an absolute URL when a rest ends.
NEXT_PUBLIC_SITE_URL=

# Upstash QStash, which schedules the notification for the end of a rest.
# Optional: without these the rest timer still counts down and still plays its
# sound, and the timer says so when it could not schedule an alert.
#
# The STORAGE_ prefix is what the Vercel integration provisions. The SDK reads
# bare QSTASH_* names by default and would find nothing, so these are passed
# explicitly wherever they are used.
STORAGE_QSTASH_URL=
STORAGE_QSTASH_TOKEN=
STORAGE_QSTASH_CURRENT_SIGNING_KEY=
STORAGE_QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis, which backs the rate limits on sign in and on the rest
# callback. Optional: absent, rate limiting is simply disabled, which is the
# normal state locally.
#
# These are the names the Vercel integration provisions for a Redis resource,
# and they are the REST pair rather than the TCP connection string. The code
# passes them explicitly instead of calling the SDK's fromEnv helper.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI quick entry, the typed set parser on the exercise card. Optional: without
# it the field still renders and fails with a friendly message, and every other
# way of logging a set is unaffected. Create the key in the Claude Console at
# platform.claude.com/settings/keys, and set it Sensitive in Vercel.
ANTHROPIC_API_KEY=

# The end to end suite, `npm run test:e2e`. Only needed to run those tests.
#
# One account per browser, because startSession resumes any workout left open
# regardless of routine, so a session abandoned by one run would be inherited
# by the next. Both accounts are WIPED AND RESEEDED before every run, so
# neither may be your own address or the demo one. Create them in the Supabase
# dashboard under Authentication, Users, marked confirmed.
#
# SUPABASE_SERVICE_ROLE_KEY above is required too: the reseed runs as admin.
E2E_EMAIL_CHROMIUM=
E2E_EMAIL_WEBKIT=
E2E_PASSWORD=
