# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Maintainer private files (never tracked)
CLAUDE.md
future-ideas.md
salvage/

# Local-only project scaffolding (workflow tells, never shipped publicly)
agents/
docs/superpowers/
docs/plan.md
STATUS.md

# Tooling artifacts
.superpowers/
.claude/
.specstory/
